generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
  SUPERADMIN
}

enum PaymentMethod {
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  EWALLET
  QRIS
  CREDIT_CARD
  COD
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  role         Role          @default(MEMBER)
  username     String?
  name         String?
  posts        Post[]
  sessions     AuthSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model Product {
  id            Int     @id @default(autoincrement())
  name          String
  description   String
  size          String[]
  material      String[]
  color         String[]
  feature       String[] @default([])
  price         Decimal @db.Decimal(10,2)
  quantity      Int  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

}