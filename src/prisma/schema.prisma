generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
  SUPERADMIN
}

enum PaymentMethod {
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  EWALLET
  QRIS
  CREDIT_CARD
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  role         Role          @default(MEMBER)
  username     String?
  name         String?
  posts        Post[]
  sessions     AuthSession[]
  cart         Cart?
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  size        String[]
  material    String[]
  color       String[]
  feature     String[]    @default([])
  price       Decimal     @db.Decimal(10, 2)
  quantity    Int         @default(0)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status       OrderStatus @default(PENDING_PAYMENT)
  subtotal     Decimal     @db.Decimal(14, 2)
  shippingCost Decimal     @db.Decimal(14, 2)
  discount     Decimal     @default(0) @db.Decimal(14, 2)
  totalAmount  Decimal     @db.Decimal(14, 2)
  currency     String      @default("IDR")
  notes        String?
  items        OrderItem[]
  shipment     Shipment?
  payments     Payment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

// Product name/price are copied at purchase time so history survives product edits
model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  unitPrice   Decimal @db.Decimal(14, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(14, 2)

  @@index([orderId])
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        String
  service        String
  cost           Decimal        @db.Decimal(14, 2)
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  recipientName  String
  phone          String
  address        String
  city           String
  province       String
  postalCode     String
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("IDR")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  provider    String? // e.g. "midtrans", "xendit"
  providerRef String?       @unique // transaction id from the gateway
  paymentUrl  String? // redirect / checkout URL
  paidAt      DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}